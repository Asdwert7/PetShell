// === Этап 5: тест модифицирующих команд VFS (rm, rmdir) ===

/* Старт: загружаем минимальную VFS */
vfs-init vfs/minimal.json

/* Посмотрим, что есть в корне и в home */
pwd
ls
ls home

/* Удаляем файл в home */
rm home/readme.txt
ls home

/* Ошибка: пытаемся удалить несуществующий файл */
rm home/readme.txt

/* Ошибка: пытаемся rm на каталог */
rm home

/* Пробуем удалить непустой каталог /home -> ошибка */
rmdir /home

/* Создадим пустой каталог вручную в JSON — тут его нет,
   поэтому для демонстрации удалим пустой каталог /etc,
   но сначала убедимся, что он пуст или очистим сценарий под твой JSON */
ls /etc
rmdir /etc   // если в /etc есть файлы — будет "каталог не пуст"

/* Ошибка: путь не существует */
rmdir /nope

/* Ошибка: rmdir на файл */
rmdir /welcome.txt

/* Сбросим VFS и проверим пустой вывод */
vfs-init
pwd
ls

exit 0