// === ТЕСТ ВСЕХ ФУНКЦИЙ ЭМУЛЯТОРА ===
// Комментарии поддерживаются: // и /* ... */

/* Раздел 1. Парсер аргументов (кавычки/экраны) */
echo hello world
echo "hello world"
echo 'a "b c"'
echo a\ b c
echo ""            // пустой аргумент
echo "склеенные""к" "а""в""ы""ч""к""и"

/* Раздел 2. Ошибки парсинга */
echo "unterminated    // ожидаем сообщение об ошибке парсера

/* Раздел 3. Неизвестная команда */
abracadabra          // ожидаем: Ошибка: неизвестная команда 'abracadabra'

/* Раздел 4. Заглушки встроенных команд */
ls -l -a
cd "/tmp folder"     // заглушка просто печатает аргументы

/* Раздел 5. VFS: успехи и ошибки */
vfs-init vfs/minimal.json   // корректная загрузка
vfs-init vfs/NO_SUCH.json   // файл не найден → ошибка загрузки
vfs-init vfs/bad.json       // битый JSON → ошибка загрузки

/* Неверное использование vfs-init */
vfs-init a.json b.json      // ожидаем Usage и код 2 (у тебя так реализовано)

/* Раздел 6. Сброс VFS по умолчанию */
vfs-init                    // reset до пустой VFS

/* Раздел 7. Финал */
exit 5